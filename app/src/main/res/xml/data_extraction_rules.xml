<?xml version="1.0" encoding="utf-8"?>
<!-- Правила бэкапа для Android 12+ (API 31+) -->
<data-extraction-rules>
    <cloud-backup>
        <!-- Включаем все SharedPreferences в облачный бэкап -->
        <include domain="sharedpref" path="."/>
    </cloud-backup>
    <device-transfer>
        <!-- Включаем все SharedPreferences при переносе на новое устройство -->
        <include domain="sharedpref" path="."/>
    </device-transfer>
</data-extraction-rules>
