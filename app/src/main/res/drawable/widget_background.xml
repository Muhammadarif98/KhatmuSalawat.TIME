<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Outer border with gold gradient -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#C9A227"
                android:centerColor="#E8D48B"
                android:endColor="#C9A227"
                android:angle="135" />
            <corners android:radius="24dp" />
        </shape>
    </item>
    <!-- Inner background with warm cream gradient -->
    <item
        android:left="4dp"
        android:top="4dp"
        android:right="4dp"
        android:bottom="4dp">
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#F5E6C8"
                android:centerColor="#FFFEF8"
                android:endColor="#EDD9A8"
                android:angle="135"
                android:type="linear" />
            <corners android:radius="20dp" />
        </shape>
    </item>
</layer-list>
